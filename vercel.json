{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ],
  "services": {
    "frontend": {
      "root": ".",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "main:app"
    }
  },
  "env": {
    "DATABASE_URL": "/tmp/mnemorix.db",
    "FRONTEND_ORIGIN": "https://attachments-inky.vercel.app"
  }
}
